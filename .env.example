# ==========================================================
# TechFix — Environment Variables (.env.example)
# Usage: Copy this file to ".env" in the project root
#   cp .env.example .env
# and fill in your local credentials.
# ==========================================================

# ---------- 1. Database (MySQL / MariaDB on XAMPP) ----------
TECHFIX_DB_HOST=localhost
TECHFIX_DB_NAME=techfix
TECHFIX_DB_USER=root
TECHFIX_DB_PASS=

# ---------- 2. Email Notifications (Gmail SMTP) ----------
# How to generate a Gmail App Password:
# 1. Enable 2-Step Verification on your Google Account.
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create a new App Password for "TechFix" to receive a 16-character key.
# 4. Set TECHFIX_SMTP_USER to your Gmail address and TECHFIX_SMTP_PASS to the 16-character key.
TECHFIX_SMTP_HOST=smtp.gmail.com
TECHFIX_SMTP_PORT=465
TECHFIX_SMTP_USER=your_email@gmail.com
TECHFIX_SMTP_PASS=xxxx_xxxx_xxxx_xxxx
TECHFIX_MAIL_FROM_NAME="TechFix — Hệ thống sửa chữa thiết bị"
